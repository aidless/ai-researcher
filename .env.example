# ai-researcher — environment example (copy to .env and fill in)
# Do not commit real credentials. This file is names only.

# Historical name. The value is the credential for LLM_API_URL.
# The default URL below is OpenRouter, so the value is an OpenRouter key
# unless LLM_API_URL is changed. A localhost URL does not need this variable.
SILICONFLOW_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
REVIEW_MODEL=mistralai/mistral-large

# If set, two_seat.review reads this JSON instead of calling a model.
# The file must contain fixture=true. A fixture is not a verdict.
# Leave unset on the live path. The offline fixture sets it itself.
AI_RESEARCHER_REVIEW_FIXTURE=

# Optional. Kernel-readable checkout root when the directory name contains
# a single backslash and ordinary path joins double it.
EVO_REPO_ROOT=

# ---- experiment scale (demo/ scripts) ----
EVO_ROUNDS=
EVO_RUNS=
EVO_K=
EVO_LIMIT=
EVO_SEED=
EVO_SEEDS=
EVO_FORCE_DECIDE=
